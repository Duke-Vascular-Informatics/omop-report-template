.Rproj.user
.Rhistory
.RData
.Ruserdata
*.Rproj

# renv library / cache — restored from renv.lock, never committed
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/
renv/staging/

# Rendered reports + copied-in results — this repo renders, it does not store.
# Which is which, because three similar names is otherwise confusing:
#   reports/   WHERE RENDERS GO when the source is an extracted export archive.
#              This is the one you want.
#   output/    legacy default from before reports/ existed (a render used to
#              land next to its results, which for an archive meant inside
#              export_data/.extracted/ — the directory the next render deletes).
#              Nothing writes here now; safe to delete if you still have one.
#   results/   vestigial; nothing in this repo has ever written here. Kept
#              ignored only so a hand-copied results directory can't be
#              committed by accident.
output/
results/
reports/
*.docx

# Secure-environment export drop-zone. Copy an approved export .zip in here and
# GenerateReport.R renders from it instead of the synthetic dev data (see that
# script's header). NEVER commit anything from this directory: it holds real
# results, and the archive is only aggregate because the export step made
# it so -- that is not a property this repo can enforce after the fact.
# The README placeholder is the one tracked exception.
export_data/*
!export_data/README.md

.DS_Store
